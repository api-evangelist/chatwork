{
  "opencollection": "1.0.0",
  "info": {
    "name": "Chatwork API v2 Contacts API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-ChatWorkToken",
      "value": "{{X-ChatWorkToken}}",
